NODE_ENV=development
PORT=3001
DATABASE_URL=./data/app.db

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
SESSION_SECRET=change-this-secret-in-production-min32chars

# Google OAuth 2.0 — create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/callback

# ── Admin panel ───────────────────────────────────────────────────────────────
# Must be at least 8 characters
ADMIN_TOKEN=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Cache TTLs ────────────────────────────────────────────────────────────────
CACHE_TTL_PRICE_SECONDS=300
CACHE_TTL_FX_SECONDS=600

# ── BYMA live feed (optional) ─────────────────────────────────────────────────
# Not required when running with the mock price client (default for development)
# BYMA_API_BASE_URL=https://api.byma.com.ar
# BYMA_API_KEY=your_key_here
